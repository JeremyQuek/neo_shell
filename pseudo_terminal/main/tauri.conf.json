{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NASH",
  "version": "1.0.0",
  "identifier": "com.jeremyquek.nash",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "npm run vendor", "wait": true },
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NASH",
        "width": 900,
        "height": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
